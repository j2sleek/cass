<Layouts.flash_group flash={@flash} />

<div class="min-h-screen bg-white text-zinc-800 dark:bg-[#0b0b14] dark:text-zinc-200">
  <header class="sticky top-0 z-30 border-b border-zinc-200/70 bg-white/85 backdrop-blur dark:border-white/10 dark:bg-[#0b0b14]/85">
    <div class="mx-auto flex h-16 w-full max-w-6xl items-center justify-between px-4 sm:px-6 lg:px-8">
      <a
        href={~p"/"}
        class="rounded-lg outline-none focus-visible:ring-2 focus-visible:ring-brand-500"
        aria-label="CASS Marketplace home"
      >
        <Layouts.brand_mark />
      </a>

      <nav class="hidden items-center gap-1 sm:flex md:gap-2" aria-label="Primary">
        <a
          href="#categories"
          class="rounded-lg px-3 py-2 text-sm font-medium text-zinc-600 transition-colors hover:text-brand-700 dark:text-zinc-300 dark:hover:text-brand-300"
        >
          Categories
        </a>
        <a
          href="#features"
          class="rounded-lg px-3 py-2 text-sm font-medium text-zinc-600 transition-colors hover:text-brand-700 dark:text-zinc-300 dark:hover:text-brand-300"
        >
          What&apos;s included
        </a>
        <a
          href="#about"
          class="rounded-lg px-3 py-2 text-sm font-medium text-zinc-600 transition-colors hover:text-brand-700 dark:text-zinc-300 dark:hover:text-brand-300"
        >
          About
        </a>
        <a
          href="#categories"
          class="ml-2 inline-flex items-center gap-1.5 rounded-full bg-brand-600 px-4 py-2 text-sm font-semibold text-white shadow-sm transition-all hover:bg-brand-700 hover:shadow focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 focus-visible:ring-offset-2 dark:focus-visible:ring-offset-[#0b0b14]"
        >
          Get started
        </a>
        <%= if @current_scope && @current_scope.user do %>
          <.link
            navigate={~p"/users/settings"}
            id="nav-settings"
            class="rounded-lg px-3 py-2 text-sm font-medium text-zinc-600 transition-colors hover:text-brand-700 dark:text-zinc-300 dark:hover:text-brand-300"
          >
            Settings
          </.link>
          <.form
            for={to_form(%{}, as: "user")}
            id="log-out-nav-form"
            action={~p"/users/log-out"}
            method="delete"
          >
            <button
              id="nav-log-out"
              type="submit"
              class="rounded-lg px-3 py-2 text-sm font-medium text-zinc-600 transition-colors hover:text-brand-700 dark:text-zinc-300 dark:hover:text-brand-300"
            >
              Log out
            </button>
          </.form>
        <% else %>
          <.link
            navigate={~p"/users/log-in"}
            id="nav-log-in"
            class="rounded-lg px-3 py-2 text-sm font-medium text-zinc-600 transition-colors hover:text-brand-700 dark:text-zinc-300 dark:hover:text-brand-300"
          >
            Log in
          </.link>
          <.link
            navigate={~p"/users/register"}
            id="nav-register"
            class="rounded-lg px-3 py-2 text-sm font-medium text-zinc-600 transition-colors hover:text-brand-700 dark:text-zinc-300 dark:hover:text-brand-300"
          >
            Create account
          </.link>
        <% end %>
        <span class="ml-1">
          <Layouts.theme_toggle />
        </span>
      </nav>

      <div class="flex items-center gap-2 sm:hidden">
        <Layouts.theme_toggle />
        <a
          href="#categories"
          class="inline-flex items-center gap-1.5 rounded-full bg-brand-600 px-3.5 py-2 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-brand-700"
        >
          Get started
        </a>
      </div>
    </div>
  </header>

  <main id="main" class="isolate">
    <section class="relative overflow-hidden" aria-labelledby="hero-heading">
      <div class="bg-grid absolute inset-0 -z-10" aria-hidden="true"></div>
      <div
        class="absolute -top-40 left-1/2 -z-10 h-96 w-[52rem] -translate-x-1/2 rounded-full bg-brand-200/40 blur-3xl dark:bg-brand-900/30"
        aria-hidden="true"
      >
      </div>

      <div class="mx-auto w-full max-w-6xl px-4 pb-20 pt-16 sm:px-6 sm:pt-24 lg:px-8">
        <span class="inline-flex items-center gap-2 rounded-full border border-brand-200 bg-brand-50 px-3 py-1 text-xs font-semibold tracking-wide text-brand-700 uppercase dark:border-brand-800 dark:bg-brand-950 dark:text-brand-200">
          <span class="size-1.5 rounded-full bg-accent-500" aria-hidden="true"></span>
          Live marketplace
        </span>

        <h1
          id="hero-heading"
          class="mt-6 max-w-3xl text-4xl font-extrabold tracking-tight text-zinc-900 dark:text-white sm:text-5xl lg:text-6xl"
        >
          One marketplace for
          <span class="bg-gradient-to-r from-brand-600 to-accent-600 bg-clip-text text-transparent">
            digital products, marketing, and AI tools
          </span>
        </h1>

        <p class="mt-6 max-w-2xl text-lg leading-8 text-zinc-600 dark:text-zinc-300">
          CASS unifies compliant social marketing services, downloadable digital
          products, and AI-powered utilities under a single account, catalog, and
          checkout — built server-side on Elixir, Phoenix LiveView, and PostgreSQL.
        </p>

        <form
          action={~p"/catalog"}
          method="get"
          role="search"
          class="mt-8 max-w-xl"
          aria-label="Search the marketplace"
        >
          <label for="home-search" class="sr-only">
            Search the marketplace catalog
          </label>
          <div class="flex items-stretch gap-1.5 rounded-xl border border-zinc-200 bg-white p-1.5 shadow-sm transition focus-within:border-brand-300 focus-within:ring-2 focus-within:ring-brand-500/30 dark:border-white/10 dark:bg-white/5">
            <.icon
              name="hero-magnifying-glass"
              class="ml-2.5 size-5 self-center text-zinc-400"
            />
            <input
              id="home-search"
              type="search"
              name="q"
              placeholder="Search digital products, SMM, AI tools…"
              class="h-11 w-full min-w-0 bg-transparent text-sm text-zinc-900 outline-none placeholder:text-zinc-400 dark:text-white"
            />
            <button
              id="home-search-submit"
              type="submit"
              class="shrink-0 rounded-lg bg-brand-600 px-4 text-sm font-semibold text-white transition-colors hover:bg-brand-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500"
            >
              Search
            </button>
          </div>
        </form>

        <div class="mt-9 flex flex-wrap items-center gap-3">
          <a
            href={~p"/catalog"}
            class="inline-flex items-center gap-2 rounded-xl bg-brand-600 px-6 py-3 text-sm font-semibold text-white shadow-sm transition-all hover:bg-brand-700 hover:shadow-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 focus-visible:ring-offset-2 dark:focus-visible:ring-offset-[#0b0b14]"
          >
            Browse categories <.icon name="hero-arrow-right" class="size-4" />
          </a>
          <a
            href="#features"
            class="inline-flex items-center gap-2 rounded-xl border border-zinc-300 bg-white px-6 py-3 text-sm font-semibold text-zinc-700 transition-colors hover:border-brand-300 hover:text-brand-700 dark:border-white/15 dark:bg-white/5 dark:text-zinc-200 dark:hover:border-brand-700 dark:hover:text-brand-300"
          >
            What&apos;s included
          </a>
        </div>

        <dl class="mt-14 grid max-w-3xl grid-cols-1 gap-4 sm:grid-cols-3">
          <div class="rounded-xl border border-zinc-200/80 bg-white/70 p-4 dark:border-white/10 dark:bg-white/5">
            <dt class="flex items-center gap-2 text-sm font-semibold text-zinc-900 dark:text-white">
              <.icon name="hero-server-stack" class="size-4 text-brand-600 dark:text-brand-400" />
              Server-rendered
            </dt>
            <dd class="mt-1 text-sm text-zinc-500 dark:text-zinc-400">
              SEO-friendly pages rendered by Phoenix LiveView.
            </dd>
          </div>
          <div class="rounded-xl border border-zinc-200/80 bg-white/70 p-4 dark:border-white/10 dark:bg-white/5">
            <dt class="flex items-center gap-2 text-sm font-semibold text-zinc-900 dark:text-white">
              <.icon name="hero-cube" class="size-4 text-brand-600 dark:text-brand-400" />
              Modular monolith
            </dt>
            <dd class="mt-1 text-sm text-zinc-500 dark:text-zinc-400">
              One deployable Elixir app with clear domain contexts.
            </dd>
          </div>
          <div class="rounded-xl border border-zinc-200/80 bg-white/70 p-4 dark:border-white/10 dark:bg-white/5">
            <dt class="flex items-center gap-2 text-sm font-semibold text-zinc-900 dark:text-white">
              <.icon name="hero-database" class="size-4 text-brand-600 dark:text-brand-400" />
              PostgreSQL backed
            </dt>
            <dd class="mt-1 text-sm text-zinc-500 dark:text-zinc-400">
              Durable transactions and Ecto migrations.
            </dd>
          </div>
        </dl>
      </div>
    </section>

    <section
      id="categories"
      class="scroll-mt-20 border-t border-zinc-200/70 bg-zinc-50/70 py-20 dark:border-white/10 dark:bg-white/[0.02]"
      aria-labelledby="categories-heading"
    >
      <div class="mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
          <div class="max-w-2xl">
            <p class="text-sm font-semibold tracking-wide text-brand-700 uppercase dark:text-brand-300">
              Marketplace catalog
            </p>
            <h2
              id="categories-heading"
              class="mt-2 text-3xl font-bold tracking-tight text-zinc-900 dark:text-white sm:text-4xl"
            >
              Explore the marketplace
            </h2>
            <p class="mt-4 text-base leading-7 text-zinc-600 dark:text-zinc-300">
              Browse live listings for digital products, compliant social
              marketing services, and AI tools — by category or by what&apos;s
              newest in the catalog.
            </p>
          </div>
          <.link
            navigate={~p"/catalog"}
            id="home-browse-catalog"
            class="inline-flex shrink-0 items-center gap-2 rounded-xl bg-brand-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition-all hover:bg-brand-700 hover:shadow-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500"
          >
            Browse all products <.icon name="hero-arrow-right" class="size-4" />
          </.link>
        </div>

        <%= if @market_categories == [] do %>
          <p class="mt-10 rounded-2xl border border-dashed border-zinc-300 p-8 text-center text-sm text-zinc-500 dark:border-white/15 dark:text-zinc-400">
            Categories are on their way — check back soon.
          </p>
        <% else %>
          <div class="mt-10 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
            <%= for category <- Enum.take(@market_categories, 6) do %>
              <.link
                navigate={~p"/catalog/categories/#{category.slug}"}
                class="group flex items-center gap-4 rounded-2xl border border-zinc-200 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:border-brand-300 hover:shadow-md dark:border-white/10 dark:bg-white/5 dark:hover:border-brand-500/40"
              >
                <span class="grid size-11 shrink-0 place-items-center rounded-xl bg-brand-50 text-brand-600 dark:bg-brand-500/10 dark:text-brand-300">
                  <.icon name="hero-folder" class="size-5" />
                </span>
                <span class="min-w-0">
                  <span class="block text-sm font-semibold tracking-tight text-zinc-900 group-hover:text-brand-700 dark:text-white">
                    {category.name}
                  </span>
                  <span class="mt-1 block truncate text-xs text-zinc-500 dark:text-zinc-400">
                    <%= if category.description && category.description != "" do %>
                      {category.description}
                    <% else %>
                      Active listings in this category
                    <% end %>
                  </span>
                </span>
              </.link>
            <% end %>
          </div>
        <% end %>

        <div class="mt-12">
          <div class="flex items-baseline justify-between gap-4">
            <h3 class="text-lg font-semibold tracking-tight text-zinc-900 dark:text-white">
              Latest listings
            </h3>
            <.link
              navigate={~p"/catalog"}
              class="text-sm font-medium text-brand-600 transition hover:text-brand-700 dark:text-brand-300"
            >
              View all
            </.link>
          </div>

          <%= if @market_products == [] do %>
            <p class="mt-6 rounded-2xl border border-dashed border-zinc-300 p-8 text-center text-sm text-zinc-500 dark:border-white/15 dark:text-zinc-400">
              No listings published yet — the first products will appear here.
            </p>
          <% else %>
            <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
              <%= for product <- @market_products do %>
                <ProductCard.product_card product={product} />
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    </section>

    <section id="features" class="scroll-mt-20 py-20" aria-labelledby="features-heading">
      <div class="mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-2">
          <div>
            <p class="text-sm font-semibold tracking-wide text-brand-700 uppercase dark:text-brand-300">
              Foundation first
            </p>
            <h2
              id="features-heading"
              class="mt-2 text-3xl font-bold tracking-tight text-zinc-900 dark:text-white sm:text-4xl"
            >
              What&apos;s included today
            </h2>
            <p class="mt-4 text-base leading-7 text-zinc-600 dark:text-zinc-300">
              Everything on this page is live: a searchable catalog, Paystack-backed
              checkout, tracked order fulfillment, and AI tools routed through the
              Nexus AI Gateway — all server-rendered on Phoenix LiveView.
            </p>
          </div>

          <ul class="space-y-4">
            <li class="flex items-start gap-4 rounded-xl border border-zinc-200 bg-white/70 p-5 dark:border-white/10 dark:bg-white/5">
              <.icon
                name="hero-check-circle"
                class="mt-0.5 size-5 shrink-0 text-accent-600 dark:text-accent-400"
              />
              <div>
                <p class="font-semibold text-zinc-900 dark:text-white">Live catalog and search</p>
                <p class="mt-1 text-sm leading-6 text-zinc-600 dark:text-zinc-300">
                  Published products with category browsing, free-text search, and
                  price sorting across digital products, marketing services, and AI tools.
                </p>
              </div>
            </li>
            <li class="flex items-start gap-4 rounded-xl border border-zinc-200 bg-white/70 p-5 dark:border-white/10 dark:bg-white/5">
              <.icon
                name="hero-check-circle"
                class="mt-0.5 size-5 shrink-0 text-accent-600 dark:text-accent-400"
              />
              <div>
                <p class="font-semibold text-zinc-900 dark:text-white">
                  Secure checkout and orders
                </p>
                <p class="mt-1 text-sm leading-6 text-zinc-600 dark:text-zinc-300">
                  Paystack-powered payments, per-line order tracking, and automatic
                  fulfillment delivery when a paid order completes.
                </p>
              </div>
            </li>
            <li class="flex items-start gap-4 rounded-xl border border-zinc-200 bg-white/70 p-5 dark:border-white/10 dark:bg-white/5">
              <.icon
                name="hero-check-circle"
                class="mt-0.5 size-5 shrink-0 text-accent-600 dark:text-accent-400"
              />
              <div>
                <p class="font-semibold text-zinc-900 dark:text-white">
                  AI tools via Nexus Gateway
                </p>
                <p class="mt-1 text-sm leading-6 text-zinc-600 dark:text-zinc-300">
                  Quota-controlled AI utilities with a graceful unavailable state —
                  the marketplace works fully even when the AI gateway is offline.
                </p>
              </div>
            </li>
            <li class="flex items-start gap-4 rounded-xl border border-zinc-200 bg-white/70 p-5 dark:border-white/10 dark:bg-white/5">
              <.icon
                name="hero-check-circle"
                class="mt-0.5 size-5 shrink-0 text-accent-600 dark:text-accent-400"
              />
              <div>
                <p class="font-semibold text-zinc-900 dark:text-white">Seller and vendor tools</p>
                <p class="mt-1 text-sm leading-6 text-zinc-600 dark:text-zinc-300">
                  Create, edit, price, and publish products with variants from the
                  vendor dashboard, with clear authorization boundaries.
                </p>
              </div>
            </li>
          </ul>
        </div>
      </div>
    </section>
  </main>

  <footer
    id="about"
    class="scroll-mt-20 border-t border-zinc-200/70 bg-zinc-50/70 dark:border-white/10 dark:bg-white/[0.02]"
    aria-labelledby="footer-heading"
  >
    <div class="mx-auto w-full max-w-6xl px-4 py-16 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 gap-12 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <Layouts.brand_mark />
          <p class="mt-5 max-w-sm text-sm leading-6 text-zinc-600 dark:text-zinc-300">
            A unified marketplace for digital products, compliant social marketing
            services, and AI-powered tools — built with Elixir, Phoenix LiveView,
            and PostgreSQL.
          </p>
          <p class="mt-4 max-w-sm text-xs leading-5 text-zinc-500 dark:text-zinc-400">
            Paystack checkout and automated fulfillment are live: a paid order is
            tracked line by line as a delivery, and completing a delivery records
            your access. AI tools run through the Nexus AI Gateway with a graceful
            fallback when the gateway is unavailable.
          </p>
        </div>

        <nav class="lg:col-span-3" aria-label="Marketplace">
          <h3 id="footer-heading" class="sr-only">Footer</h3>
          <p class="text-sm font-semibold text-zinc-900 dark:text-white">Marketplace</p>
          <ul class="mt-4 space-y-3 text-sm">
            <li>
              <a
                href={~p"/catalog"}
                class="inline-block py-1.5 text-zinc-500 transition-colors hover:text-brand-700 dark:text-zinc-400 dark:hover:text-brand-300"
              >
                Browse the catalog
              </a>
            </li>
            <li>
              <a
                href={~p"/catalog"}
                class="inline-block py-1.5 text-zinc-500 transition-colors hover:text-brand-700 dark:text-zinc-400 dark:hover:text-brand-300"
              >
                Latest listings
              </a>
            </li>
            <li>
              <a
                href={~p"/catalog"}
                class="inline-block py-1.5 text-zinc-500 transition-colors hover:text-brand-700 dark:text-zinc-400 dark:hover:text-brand-300"
              >
                Search the catalog
              </a>
            </li>
            <li class="text-zinc-500 dark:text-zinc-400">
              Physical products
              <span class="ml-1 text-xs text-zinc-500 dark:text-zinc-400">(later)</span>
            </li>
          </ul>
        </nav>

        <nav class="lg:col-span-2" aria-label="Company">
          <p class="text-sm font-semibold text-zinc-900 dark:text-white">Company</p>
          <ul class="mt-4 space-y-3 text-sm">
            <li class="text-zinc-500 dark:text-zinc-400">About</li>
            <li class="text-zinc-500 dark:text-zinc-400">Contact</li>
            <li class="text-zinc-500 dark:text-zinc-400">Privacy</li>
          </ul>
        </nav>

        <nav class="lg:col-span-2" aria-label="Developers">
          <p class="text-sm font-semibold text-zinc-900 dark:text-white">Developers</p>
          <ul class="mt-4 space-y-3 text-sm">
            <li>
              <a
                href={~p"/api/v1/health"}
                class="inline-block py-1.5 text-zinc-500 transition-colors hover:text-brand-700 dark:text-zinc-400 dark:hover:text-brand-300"
              >
                Health endpoint
              </a>
            </li>
            <li class="text-zinc-500 dark:text-zinc-400">
              API reference
              <span class="ml-1 text-xs text-zinc-500 dark:text-zinc-400">(soon)</span>
            </li>
          </ul>
        </nav>
      </div>

      <div class="mt-12 flex flex-col items-start justify-between gap-3 border-t border-zinc-200 pt-8 text-xs text-zinc-500 dark:border-white/10 dark:text-zinc-400 sm:flex-row sm:items-center">
        <p>© 2026 CASS Marketplace</p>
        <p>Built with Phoenix on Elixir/OTP.</p>
      </div>
    </div>
  </footer>
</div>
