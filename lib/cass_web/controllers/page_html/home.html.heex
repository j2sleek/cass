<Layouts.site_header />

<div class="min-h-screen bg-white text-zinc-800 dark:bg-[#0b0b14] dark:text-zinc-200">
  <Layouts.flash_group flash={@flash} />

  <main id="main" class="isolate">
    <section class="relative overflow-hidden" aria-labelledby="hero-heading">
      <div class="bg-grid absolute inset-0 -z-10" aria-hidden="true"></div>
      <div
        class="absolute -top-40 left-1/2 -z-10 h-96 w-[52rem] -translate-x-1/2 rounded-full bg-brand-200/40 blur-3xl dark:bg-brand-900/30"
        aria-hidden="true"
      >
      </div>

      <div class="mx-auto w-full max-w-6xl px-4 pb-16 pt-14 sm:px-6 sm:pt-20 lg:px-8">
        <span class="inline-flex items-center gap-2 rounded-full border border-brand-200 bg-brand-50 px-3 py-1 text-xs font-semibold tracking-wide text-brand-700 uppercase dark:border-brand-800 dark:bg-brand-950 dark:text-brand-200">
          <span class="size-1.5 rounded-full bg-accent-500" aria-hidden="true"></span>
          Payments, credits and delivery tracking are live
        </span>

        <h1
          id="hero-heading"
          class="mt-6 max-w-3xl text-4xl font-extrabold tracking-tight text-zinc-900 dark:text-white sm:text-5xl lg:text-6xl"
        >
          One marketplace for
          <span class="bg-gradient-to-r from-brand-600 to-accent-600 bg-clip-text text-transparent">
            digital products, marketing, and AI tools
          </span>
        </h1>

        <p class="mt-6 max-w-2xl text-lg leading-8 text-zinc-600 dark:text-zinc-300">
          Buy templates, media packages and AI utilities with one account and one
          checkout. Every paid order becomes a delivery you can follow, and every
          completed delivery becomes access you can use.
        </p>

        <div class="mt-9 max-w-2xl">
          <CassWeb.Storefront.search_form id="hero-search" class="w-full sm:max-w-xl" />
        </div>

        <div class="mt-6 flex flex-wrap items-center gap-3">
          <a
            href="#categories"
            class="inline-flex items-center gap-2 rounded-xl bg-brand-600 px-6 py-3 text-sm font-semibold text-white shadow-sm transition-all hover:bg-brand-700 hover:shadow-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 focus-visible:ring-offset-2 dark:focus-visible:ring-offset-[#0b0b14]"
          >
            Browse categories <.icon name="hero-arrow-down" class="size-4" />
          </a>
          <.link
            navigate={~p"/catalog"}
            class="inline-flex items-center gap-2 rounded-xl border border-zinc-300 bg-white px-6 py-3 text-sm font-semibold text-zinc-700 transition-colors hover:border-brand-300 hover:text-brand-700 dark:border-white/15 dark:bg-white/5 dark:text-zinc-200 dark:hover:border-brand-700 dark:hover:text-brand-300"
          >
            Search everything
          </.link>
        </div>

        <dl class="mt-12 grid max-w-3xl grid-cols-1 gap-4 sm:grid-cols-3">
          <div class="rounded-xl border border-zinc-200/80 bg-white/70 p-4 dark:border-white/10 dark:bg-white/5">
            <dt class="flex items-center gap-2 text-sm font-semibold text-zinc-900 dark:text-white">
              <.icon name="hero-credit-card" class="size-4 text-brand-600 dark:text-brand-400" />
              Paystack checkout
            </dt>
            <dd class="mt-1 text-sm text-zinc-500 dark:text-zinc-400">
              Payment is recorded per order line, never as one vague total.
            </dd>
          </div>
          <div class="rounded-xl border border-zinc-200/80 bg-white/70 p-4 dark:border-white/10 dark:bg-white/5">
            <dt class="flex items-center gap-2 text-sm font-semibold text-zinc-900 dark:text-white">
              <.icon name="hero-truck" class="size-4 text-brand-600 dark:text-brand-400" />
              Tracked deliveries
            </dt>
            <dd class="mt-1 text-sm text-zinc-500 dark:text-zinc-400">
              Access is granted only after a delivery is completed.
            </dd>
          </div>
          <div class="rounded-xl border border-zinc-200/80 bg-white/70 p-4 dark:border-white/10 dark:bg-white/5">
            <dt class="flex items-center gap-2 text-sm font-semibold text-zinc-900 dark:text-white">
              <.icon name="hero-bolt" class="size-4 text-brand-600 dark:text-brand-400" />
              AI on credits
            </dt>
            <dd class="mt-1 text-sm text-zinc-500 dark:text-zinc-400">
              Gateway calls are metered against your credit balance.
            </dd>
          </div>
        </dl>
      </div>
    </section>

    <section
      id="categories"
      class="scroll-mt-20 border-t border-zinc-200/70 bg-zinc-50/70 py-16 dark:border-white/10 dark:bg-white/[0.02]"
      aria-labelledby="categories-heading"
    >
      <div class="mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-8">
        <CassWeb.Storefront.section_heading
          id="categories-heading"
          title="Browse categories"
          subtitle="Start from a category, or filter the whole catalog by what you need."
        >
          <:action>
            <.link
              navigate={~p"/catalog"}
              class="text-sm font-semibold text-brand-600 transition hover:text-brand-700 dark:text-brand-300 dark:hover:text-brand-200"
            >
              See all products
            </.link>
          </:action>
        </CassWeb.Storefront.section_heading>

        <%= if @categories == [] do %>
          <CassWeb.Storefront.empty_state
            id="no-categories"
            title="No categories published yet"
            body="Categories appear here as soon as an admin activates them."
            icon="hero-squares-2x2"
          />
        <% else %>
          <ul id="home-category-grid" class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
            <li
              :for={category <- @categories}
              class="group relative flex flex-col rounded-2xl border border-zinc-200 bg-white p-5 shadow-sm transition duration-200 hover:-translate-y-0.5 hover:border-brand-300 hover:shadow-md motion-reduce:transform-none dark:border-white/10 dark:bg-white/5 dark:hover:border-brand-500/40"
            >
              <.link
                navigate={~p"/catalog/categories/#{category.slug}"}
                class="flex h-full flex-col focus-visible:outline-none"
              >
                <span class="grid size-11 place-items-center rounded-xl bg-brand-50 text-brand-700 transition-colors group-hover:bg-brand-100 dark:bg-brand-950 dark:text-brand-300 dark:group-hover:bg-brand-900">
                  <.icon
                    name={CassWeb.Storefront.category_icon(category.id)}
                    class="size-5"
                  />
                </span>
                <span class="mt-4 text-sm font-semibold text-zinc-900 dark:text-white">
                  {category.name}
                </span>
                <span
                  :if={category.description}
                  class="mt-1 line-clamp-2 text-xs leading-5 text-zinc-500 dark:text-zinc-400"
                >
                  {category.description}
                </span>
              </.link>
            </li>
          </ul>
        <% end %>
      </div>
    </section>

    <section
      :if={@featured_products != []}
      class="py-16"
      aria-labelledby="featured-heading"
    >
      <div class="mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-8">
        <CassWeb.Storefront.section_heading
          id="featured-heading"
          title="Featured right now"
          subtitle="Picked by the CASS team from what is published and in stock."
        />
        <ul
          id="featured-products"
          class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4"
        >
          <li :for={product <- @featured_products}>
            <CassWeb.ProductCard.product_card product={product} />
          </li>
        </ul>
      </div>
    </section>

    <section
      :if={@latest_products != []}
      class="border-t border-zinc-200/70 bg-zinc-50/70 py-16 dark:border-white/10 dark:bg-white/[0.02]"
      aria-labelledby="latest-heading"
    >
      <div class="mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-8">
        <CassWeb.Storefront.section_heading
          id="latest-heading"
          title="Latest additions"
          subtitle="The most recently published products across every category."
        >
          <:action>
            <.link
              navigate={~p"/catalog?sort=newest"}
              class="text-sm font-semibold text-brand-600 transition hover:text-brand-700 dark:text-brand-300 dark:hover:text-brand-200"
            >
              Browse the catalog
            </.link>
          </:action>
        </CassWeb.Storefront.section_heading>

        <ul
          id="latest-products"
          class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4"
        >
          <li :for={product <- @latest_products}>
            <CassWeb.ProductCard.product_card product={product} />
          </li>
        </ul>
      </div>
    </section>

    <section
      class="border-t border-zinc-200/70 py-16 dark:border-white/10"
      aria-labelledby="types-heading"
    >
      <div class="mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-8">
        <CassWeb.Storefront.section_heading
          id="types-heading"
          title="What you can buy on CASS"
          subtitle="Three kinds of listing, each with its own delivery mechanics."
        />

        <ul id="product-type-grid" class="grid grid-cols-1 gap-6 md:grid-cols-3">
          <li
            :for={product_type <- @product_types}
            class="flex flex-col rounded-2xl border border-zinc-200 bg-white p-7 shadow-sm transition duration-200 hover:-translate-y-0.5 hover:border-brand-300 hover:shadow-md motion-reduce:transform-none dark:border-white/10 dark:bg-white/5 dark:hover:border-brand-500/40"
          >
            <span class="grid size-12 place-items-center rounded-xl bg-brand-50 text-brand-700 dark:bg-brand-950 dark:text-brand-300">
              <.icon name={CassWeb.Format.product_type_icon(product_type)} class="size-6" />
            </span>
            <h3 class="mt-5 text-lg font-semibold text-zinc-900 dark:text-white">
              {CassWeb.Format.product_type_heading(product_type)}
            </h3>
            <p class="mt-2 text-sm leading-6 text-zinc-600 dark:text-zinc-300">
              {CassWeb.Format.product_type_blurb(product_type)}
            </p>
            <div class="mt-5">
              <.link
                navigate={~p"/catalog?type=#{product_type}"}
                class="inline-flex items-center gap-1.5 text-sm font-semibold text-brand-600 transition hover:gap-2 hover:text-brand-700 dark:text-brand-300 dark:hover:text-brand-200"
              >
                Browse listings <.icon name="hero-arrow-right" class="size-4" />
              </.link>
            </div>
          </li>
        </ul>

        <div class="mt-6 rounded-2xl border border-dashed border-zinc-300 p-7 dark:border-white/15">
          <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
            <div class="flex items-start gap-4">
              <span class="grid size-12 shrink-0 place-items-center rounded-xl bg-zinc-100 text-zinc-500 dark:bg-white/10 dark:text-zinc-400">
                <.icon name="hero-building-storefront" class="size-6" />
              </span>
              <div>
                <h3 class="text-lg font-semibold text-zinc-900 dark:text-white">
                  Physical products
                </h3>
                <p class="mt-1 text-sm leading-6 text-zinc-600 dark:text-zinc-300">
                  Selected goods from approved vendors are evaluated for a later
                  phase, after inventory and shipping complexity is justified.
                </p>
              </div>
            </div>
            <span class="inline-flex shrink-0 items-center rounded-full bg-zinc-100 px-3 py-1 text-xs font-medium text-zinc-500 dark:bg-white/10 dark:text-zinc-400">
              Not in MVP scope
            </span>
          </div>
        </div>
      </div>
    </section>

    <section
      class="border-t border-zinc-200/70 py-16 dark:border-white/10"
      aria-labelledby="how-heading"
    >
      <div class="mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-8">
        <CassWeb.Storefront.section_heading
          id="how-heading"
          title="How an order becomes access"
          subtitle="The same four steps for every listing, whatever kind it is."
        />

        <ol class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
          <li
            :for={
              {step, title, body} <- [
                {"01", "Check out",
                 "Paystack confirms the payment and the order is split into one delivery per line item."},
                {"02", "Delivery queued",
                 "Fulfilment runs through a durable job queue, so a busy queue never loses an order."},
                {"03", "Delivery completes",
                 "Each delivery transitions from pending to processing to completed, with every step recorded."},
                {"04", "Access granted",
                 "Only a completed delivery unlocks the product, and access is scoped to your account."}
              ]
            }
            class="flex h-full flex-col rounded-2xl border border-zinc-200 bg-white p-6 shadow-sm dark:border-white/10 dark:bg-white/5"
          >
            <span class="text-xs font-bold tracking-widest text-brand-600 dark:text-brand-300">
              {step}
            </span>
            <h3 class="mt-3 text-base font-semibold text-zinc-900 dark:text-white">{title}</h3>
            <p class="mt-2 text-sm leading-6 text-zinc-600 dark:text-zinc-300">{body}</p>
          </li>
        </ol>
      </div>
    </section>
  </main>

  <Layouts.site_footer categories={@categories} />
</div>
